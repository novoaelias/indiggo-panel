# Copiá este archivo como .dev.vars (NO lo subas al repo) y completá los valores.
# En producción cada clave se carga con:  npx wrangler secret put NOMBRE

# --- Claude API (motor cognitivo) ---
ANTHROPIC_API_KEY=

# --- kie.ai (generación de imágenes / video para redes) ---
KIE_API_KEY=

# --- Supabase (proyecto "Indiggo") ---
SUPABASE_URL=https://<tu-proyecto-supabase>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# --- Gate del panel (opcional pero recomendado hasta tener Cloudflare Access) ---
# Si tiene valor, el panel pide esta clave para entrar. Vacío = sin gate.
PANEL_TOKEN=

# --- Google Sheets (planilla de reparto Flex "INDIGGO") ---
# Service Account de Google Cloud (Sheets API habilitada). Del JSON de la clave:
#   client_email  -> GOOGLE_SA_EMAIL
#   private_key   -> GOOGLE_SA_PRIVATE_KEY  (entre comillas, con los \n literales)
# La planilla está en "cualquiera con el link puede editar": no hay que compartirla.
# El ID de la planilla (SHEETS_ID) va en wrangler.jsonc (no es secreto).
GOOGLE_SA_EMAIL=
GOOGLE_SA_PRIVATE_KEY=

# --- MercadoLibre (app OAuth2 + PKCE, site MLA) ---
ML_CLIENT_ID=
ML_CLIENT_SECRET=
# Dejar vacío: se deriva como <origin>/api/ml/callback. Sólo setear para forzar otra URL.
ML_REDIRECT_URI=
# Opcional: se obtiene solo de /users/me tras conectar. No hace falta cargarlo.
ML_SELLER_ID=

# --- Web Push (notificaciones PWA) ---
# Generá un par P-256/VAPID y mantené privada VAPID_PRIVATE_KEY.
VAPID_SERVER_PUBLIC_KEY=
VAPID_SERVER_PRIVATE_KEY=
VAPID_SUBJECT=mailto:soporte@example.com
