# Copiá este archivo como .dev.vars (NO lo subas al repo) y completá los valores.
# En producción cada clave se carga con:  npx wrangler secret put NOMBRE

# --- Claude API (motor cognitivo) ---
ANTHROPIC_API_KEY=

# --- kie.ai (generación de imágenes / video para redes) ---
KIE_API_KEY=

# --- Supabase (proyecto "Indiggo") ---
SUPABASE_URL=https://<tu-proyecto-supabase>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# --- MercadoLibre (app OAuth2 + PKCE, site MLA) ---
ML_CLIENT_ID=
ML_CLIENT_SECRET=
ML_REDIRECT_URI=
ML_SELLER_ID=
